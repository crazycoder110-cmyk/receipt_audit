GROQ_API_KEY=gsk_...
# Groq limits are per model: bulk reading on the fast model, reasoning + tools on the big one
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Client-side limiter (Groq free tier defaults). Raise on a paid plan.
GROQ_TPM=8000
GROQ_RPM=30
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
REDIRECT_URI=http://localhost:8501
# Only for the nightly CLI run (python agent.py statement.csv 1)
GOOGLE_REFRESH_TOKEN=
# Optional: Fortnox (Developer Portal -> My Integrations). Redirect URI defaults to REDIRECT_URI
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
